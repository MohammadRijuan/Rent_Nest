model Payment {
  id        String @id @default(uuid())
  rental_id String
  rental    Rental @relation(fields: [rental_id], references: [id], onDelete: Cascade)

  tenant_id String
  tenant    User   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  transaction String?       @unique
  amount      Decimal       @db.Decimal(10, 2)
  method      Methods       @default(SSLCOMMERZ)
  status      PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Methods {
  SSLCOMMERZ
  STRIPE
  BKASH
}
