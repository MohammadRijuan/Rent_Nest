model Rental {
  id        String @id @default(uuid())
  tenant_id String
  tenant    User   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  // property
  property_id String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  move_in_date DateTime
  message      String
  status       RentalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payments Payment[]

  @@map("rental-requests")
}

enum RentalStatus {
  PENDING
  APPROVED
  CANCELLED
}
