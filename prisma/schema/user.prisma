model User {

  id String @id @default(uuid())

  name         String
  email        String       @unique
  password     String
  activeStatus ActiveStatus @default(ACTIVE)
  role         Role         @default(TENANT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
  
  //   profileId    Profile?


  // connecting comment model
  //   comments     Comment[]
  // connecting post model
  //   posts        Post[]
  //   subscription Subscription?


  // relations
  properties Property[]
  rentals Rental[]
  reviews Reviews[]

  // rename table
  @@map("users")
}

enum ActiveStatus {
  ACTIVE
  BLOCKED
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}
